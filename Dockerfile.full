# ── PhishGuard Full Image ─────────────────────────────────────────────────────
# Includes SHAP and VirusTotal support.
# Artifacts (models/, FastText) are mounted at runtime — not baked in.
# ──────────────────────────────────────────────────────────────────────────────

FROM python:3.11-slim

# System deps: build tools + libgomp (OpenMP, required by XGBoost)
RUN apt-get update && apt-get install -y --no-install-recommends \
        build-essential \
        libgomp1 \
    && rm -rf /var/lib/apt/lists/*

WORKDIR /app

COPY src/           ./src/
COPY virus_total/   ./virus_total/
COPY models/predictor.py ./models/predictor.py
COPY requirements.full.txt ./requirements.txt

RUN pip install --no-cache-dir -r requirements.txt

# Runtime mounts expected:
#   /app/models/          ← trained artifacts (xgb, scaler, schema, shap_background)
#   /app/src/features/fastText/cc.en.300.bin  ← FastText model
#   /app/logs/            ← JSONL output

# VT API key injected at runtime via env var — never baked into the image
ENV PYTHONUNBUFFERED=1 \
    VT_API_KEY=""

CMD ["sh", "-c", "python models/predictor.py ${VT_API_KEY:+--vt-key $VT_API_KEY}"]
