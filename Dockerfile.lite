# ── PhishGuard Lightweight Image ──────────────────────────────────────────────
# No SHAP, no VirusTotal. Minimal RAM footprint.
# Artifacts (models/, FastText) are mounted at runtime — not baked in.
# ──────────────────────────────────────────────────────────────────────────────

FROM python:3.11-slim

# System deps needed to build gensim / xgboost C extensions
RUN apt-get update && apt-get install -y --no-install-recommends \
        build-essential \
        libgomp1 \
    && rm -rf /var/lib/apt/lists/*

WORKDIR /app

# Copy only source code — artifacts come in via mounts
COPY src/           ./src/
COPY virus_total/   ./virus_total/
COPY models/predictor.py ./models/predictor.py
COPY requirements.lite.txt ./requirements.txt

RUN pip install --no-cache-dir -r requirements.txt

# Runtime mounts expected:
#   /app/models/          ← trained artifacts (xgb, scaler, schema, shap_background)
#   /app/src/features/fastText/cc.en.300.bin  ← FastText model
#   /app/logs/            ← JSONL output

ENV PYTHONUNBUFFERED=1

CMD ["python", "models/predictor.py"]
