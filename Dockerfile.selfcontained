# ── PhishGuard Self-Contained Image ───────────────────────────────────────────
# Everything is baked in — FastText model, trained artifacts, source code.
# Zero mounts required. Final image will be ~8-9G.
#
# Only use this when you need a single portable artifact (e.g. air-gapped
# deployment, offline demo, shipping to a client).
# For day-to-day use prefer Dockerfile.standalone (FastText mounted).
#
# Build (this will take a while — 7.2G COPY):
#   docker build -f Dockerfile.selfcontained -t phishguard:selfcontained .
#
# Run:
#   docker run -it \
#     -v ./logs:/app/logs:rw \
#     -e VT_API_KEY=your_key \
#     phishguard:selfcontained
# ──────────────────────────────────────────────────────────────────────────────

FROM python:3.11-slim

RUN apt-get update && apt-get install -y --no-install-recommends \
        build-essential \
        libgomp1 \
    && rm -rf /var/lib/apt/lists/*

WORKDIR /app

# ── Source code ───────────────────────────────────────────────────────────────
COPY src/           ./src/
COPY virus_total/   ./virus_total/
COPY models/predictor.py ./models/predictor.py
COPY requirements.full.txt ./requirements.txt

RUN pip install --no-cache-dir -r requirements.txt

# ── Trained artifacts ─────────────────────────────────────────────────────────
COPY models/phishguard_xgb.json    ./models/
COPY models/manual_scaler.pkl      ./models/
COPY models/feature_schema.json    ./models/
COPY models/shap_background.npy    ./models/
COPY models/model_metadata.json    ./models/

# ── FastText model (7.2G — makes this image large but fully self-contained) ───
COPY src/features/fastText/cc.en.300.bin ./src/features/fastText/

VOLUME ["/app/logs"]

ENV PYTHONUNBUFFERED=1 \
    VT_API_KEY=""

CMD ["sh", "-c", "python models/predictor.py ${VT_API_KEY:+--vt-key $VT_API_KEY}"]
