# ── PhishGuard Standalone Image ───────────────────────────────────────────────
# All trained artifacts (XGBoost model, scaler, schema, SHAP background)
# are copied into the image at build time — no mounts needed for them.
#
# FastText (cc.en.300.bin, 7.2G) is still mounted at runtime because baking
# it in would produce a ~8G image that must be fully re-pushed on every
# model update. Use Dockerfile.selfcontained if you want zero mounts.
#
# Build:
#   docker build -f Dockerfile.standalone -t phishguard:standalone .
#
# Run (full, with VT):
#   docker run -it \
#     -v ./src/features/fastText:/app/src/features/fastText:ro \
#     -v ./logs:/app/logs:rw \
#     -e VT_API_KEY=your_key \
#     phishguard:standalone
#
# Run (lite, no VT):
#   docker run -it \
#     -v ./src/features/fastText:/app/src/features/fastText:ro \
#     -v ./logs:/app/logs:rw \
#     phishguard:standalone
# ──────────────────────────────────────────────────────────────────────────────

FROM python:3.11-slim

RUN apt-get update && apt-get install -y --no-install-recommends \
        build-essential \
        libgomp1 \
    && rm -rf /var/lib/apt/lists/*

WORKDIR /app

# ── Source code ───────────────────────────────────────────────────────────────
COPY src/           ./src/
COPY virus_total/   ./virus_total/
COPY models/predictor.py ./models/predictor.py
COPY requirements.full.txt ./requirements.txt

RUN pip install --no-cache-dir -r requirements.txt

# ── Trained artifacts (baked in) ──────────────────────────────────────────────
# These are copied at build time — no runtime mount needed for them.
COPY models/phishguard_xgb.json    ./models/
COPY models/manual_scaler.pkl      ./models/
COPY models/feature_schema.json    ./models/
COPY models/shap_background.npy    ./models/
COPY models/model_metadata.json    ./models/

# logs/ is still a volume so JSONL output persists on the host
VOLUME ["/app/logs"]

ENV PYTHONUNBUFFERED=1 \
    VT_API_KEY=""

CMD ["sh", "-c", "python models/predictor.py ${VT_API_KEY:+--vt-key $VT_API_KEY}"]
